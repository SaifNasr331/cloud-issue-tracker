# Copy this file to .env (the provided ZIP already contains a .env you can fill in).
# .env is listed in .gitignore and must NEVER be committed.
PORT=3000
NODE_ENV=development

# Part 9: paste your Neon connection string here (Neon Console > Connect).
# Leave it EMPTY to keep using the local JSON file (Parts 1 to 8).
DATABASE_URL=

# Frontend origins allowed by CORS, comma-separated, no trailing slash.
# On Vercel (Part 12): http://localhost:8080,https://YOUR-WEB-PROJECT.vercel.app
CORS_ORIGINS=http://localhost:8080
